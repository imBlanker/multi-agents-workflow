# Dependencies
node_modules/
package-lock.json.bak

# Build / cache
.cache/
*.log

# Local runtime state generated by the workflow runner, and local .mawf/ plans
# generated by `mawf plan` at the repo root or in sample projects. The checked-in
# sample lives at examples/.maw-sample/ and is intentionally NOT ignored.
.mawf/

# Proactive-injection runtime artifacts (advise-managed blocks) at the repo
# root — regenerated on every advise run, never tracked (see commit 3c3527f);
# untracked files would otherwise trip `mawf upgrade`'s clean-tree guard.
/AGENTS.md
/CLAUDE.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Test artifacts
tests/fixtures/*.db
tests/fixtures/*.db-*
coverage/

# Nested independent git repos (official mirror + imBlanker's pi/dsh port repos).
# Never tracked by the MAW repo; each manages its own git history.
codex-plugins/
multi-agents-workflow-0.8.1.tgz
