{
  "name": "multi-agents-workflow",
  "version": "1.0.0",
  "description": "Explicit dynamic and fixed multi-agent workflows, fenced task execution, optional adapters, and independent candidate acceptance.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mawf": "bin/mawf.js"
  },
  "files": [
    "bin",
    "src",
    "plugin",
    "skills",
    "defaults",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "vendor",
    "README.zh-Hans.md",
    "README.zh-Hant.md",
    "CHANGELOG.zh-Hans.md",
    "CHANGELOG.zh-Hant.md",
    "LICENSE",
    "NOTICE.md",
    "docs/V1_*.md",
    "docs/AGENT_INSTALL.md",
    "docs/ARCHITECTURE.md",
    "docs/UPSTREAM_COMPATIBILITY.md",
    "docs/CROSS_PLATFORM.md",
    "docs/NATIVE_WORKSPACES.md",
    "docs/AGENT_CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node --test --watch tests/",
    "smoke": "node bin/mawf.js doctor && node bin/mawf.js plan --self-test",
    "demo": "node bin/mawf.js plan --project examples/sample-project --out examples/.mawf-sample",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20.17"
  },
  "keywords": [
    "multi-agent",
    "subagents",
    "agent-workflow",
    "graph-workflow",
    "loop-engineering",
    "claude-code",
    "codex",
    "cc-switch",
    "cost-control",
    "orchestration"
  ],
  "author": "imBlanker",
  "license": "MIT",
  "homepage": "https://github.com/imBlanker/multi-agents-workflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imBlanker/multi-agents-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/imBlanker/multi-agents-workflow/issues"
  }
}
