{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=commonjs -e \"Promise.resolve().then(()=>import(require('node:url').pathToFileURL(require('node:path').resolve(process.env.CLAUDE_PLUGIN_ROOT,'../bin/guard.mjs')).href)).then(m=>m.main()).catch(()=>process.exit(2))\""
          }
        ]
      }
    ]
  }
}
